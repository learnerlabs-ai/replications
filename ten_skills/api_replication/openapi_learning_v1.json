 "info": {
  "description": "Teach a hosted learner from your own supervised examples in bounded, resumable sessions; poll the job; read the immutable checkpoint that results. Every learner also exposes an initial checkpoint -- its state before any training -- so a baseline can be measured first. Responses carry opaque ids and aggregate measurements only.",
  "title": "Learner Labs Learning API",
  "version": "1.0.0"
 },
